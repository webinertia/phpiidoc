{
    "name": "phpiidoc/phpiidoc",
    "description": "A PHP implementation of AsciiDoc, the plain-text markup language for technical documentation.",
    "license": "BSD-3-Clause",
    "keywords": [
        "asciidoc",
        "asciidoctor",
        "markup",
        "parser"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "bin": [
        "bin/phpiidoc"
    ],
    "extra": {
        "laminas": {
            "config-provider": "Phpiidoc\\ConfigProvider"
        }
    },
    "require": {
        "composer-runtime-api": "^2.2",
        "laminas/laminas-config-aggregator": "^1.20",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-servicemanager": "^4.5",
        "laminas/laminas-view": "^3.0",
        "php": "~8.4.1 || ~8.5.0",
        "psr/container": "^2.0",
        "symfony/console": "^7.4 || ^8.0",
        "webware/message-bus": "^2.0.0-beta.7",
        "webware/messagebus-event": "^2.0.0-beta.5",
        "webware/query-param-router": "1.0.x-dev",
        "webware/webware-console": "^1.0.0-alpha.7"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.4.4",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.0-rc.8"
    },
    "autoload": {
        "psr-4": {
            "Phpiidoc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpiidocTest\\": "test/unit/",
            "PhpiidocTestIntegration\\": "test/integration/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        },
        "github-protocols": [
            "https"
        ]
    },
    "scripts": {
        "console": "php bin/phpiidoc",
        "console-menu": "php bin/phpiidoc menu",
        "menu": "php bin/phpiidoc menu",
        "phpiidoc": "php bin/phpiidoc",
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection",
        "test-all": "@test && @test-integration && @mutation-test"
    }
}
